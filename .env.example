# Copia este archivo como .env y llena los valores (Supabase → Project Settings → API Keys).
# .env está en .gitignore: nunca subas la secret key al repo.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
